generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("MYSQL_DATABASE_URL")
}

model Role {
  id String @id @default(cuid()) @db.VarChar(30)
  code String @unique @db.VarChar(60)
  nom String @db.VarChar(120)
  utilisateurs Utilisateur[]
  permissions RolePermission[]
}
model Permission {
  code String @id @db.VarChar(80)
  nom String @db.VarChar(160)
  roles RolePermission[]
}
model RolePermission {
  roleId String @db.VarChar(30)
  permissionCode String @db.VarChar(80)
  role Role @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionCode], references: [code])
  @@id([roleId, permissionCode])
}
model Utilisateur {
  id String @id @default(cuid()) @db.VarChar(30)
  nom String @db.VarChar(140)
  email String @unique @db.VarChar(190)
  motDePasseHash String @db.VarChar(255)
  changementRequis Boolean @default(true)
  actif Boolean @default(true)
  roleId String @db.VarChar(30)
  permissionsPersonnalisees Json?
  porteeNationale Boolean @default(false)
  partagePosition Boolean @default(false)
  latitude Float?
  longitude Float?
  positionAt DateTime? @db.DateTime(3)
  role Role @relation(fields: [roleId], references: [id])
  siteId String? @db.VarChar(30)
  site Site? @relation(fields: [siteId], references: [id])
  zones AffectationZone[]
  sessions Session[]
  notifications Notification[]
  abonnements AbonnementPush[]
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@index([siteId, actif])
}
model AffectationZone {
  utilisateurId String @db.VarChar(30)
  geographieId String @db.VarChar(30)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  geographie Geographie @relation(fields: [geographieId], references: [id])
  @@id([utilisateurId, geographieId])
}
model Session {
  id String @id @default(cuid()) @db.VarChar(30)
  utilisateurId String @db.VarChar(30)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  empreinte String @unique @db.Char(64)
  csrfHash String @db.Char(64)
  expiresAt DateTime @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  appareil String? @db.VarChar(255)
  ip String? @db.VarChar(45)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([utilisateurId, expiresAt])
  lastSeenAt DateTime @default(now()) @db.DateTime(3)
}
model Geographie {
  id String @id @default(cuid()) @db.VarChar(30)
  nom String @db.VarChar(140)
  code String @unique @db.VarChar(50)
  niveau String @db.VarChar(60)
  parentId String? @db.VarChar(30)
  parent Geographie? @relation("Arbre", fields: [parentId], references: [id])
  enfants Geographie[] @relation("Arbre")
  actif Boolean @default(true)
  sites Site[]
  affectations AffectationZone[]
  ascendants FermetureGeographique[] @relation("Descendant")
  descendants FermetureGeographique[] @relation("Ancetre")
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([parentId, actif])
}
model FermetureGeographique {
  ancetreId String @db.VarChar(30)
  descendantId String @db.VarChar(30)
  profondeur Int
  ancetre Geographie @relation("Ancetre", fields: [ancetreId], references: [id])
  descendant Geographie @relation("Descendant", fields: [descendantId], references: [id])
  @@id([ancetreId, descendantId])
  @@index([descendantId, ancetreId])
}
model Site {
  id String @id @default(cuid()) @db.VarChar(30)
  nom String @db.VarChar(140)
  code String @unique @db.VarChar(50)
  geographieId String @db.VarChar(30)
  geographie Geographie @relation(fields: [geographieId], references: [id])
  adresse String? @db.VarChar(255)
  actif Boolean @default(true)
  utilisateurs Utilisateur[]
  assujettis Assujetti[]
  autocollants Autocollant[]
  recouvrements Recouvrement[]
  transactions TransactionFinanciere[]
  timbres Timbre[]
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([geographieId, actif])
}
model TypeMoto {
  id String @id @default(cuid()) @db.VarChar(30)
  nom String @db.VarChar(120)
  roues Int
  tarif Decimal @default(0) @db.Decimal(15, 2)
  actif Boolean @default(true)
  motos Moto[]
  tarifs Tarif[]
}
model Tarif {
  id String @id @default(cuid()) @db.VarChar(30)
  nom String @db.VarChar(140)
  typeMotoId String @db.VarChar(30)
  typeMoto TypeMoto @relation(fields: [typeMotoId], references: [id])
  geographieId String? @db.VarChar(30)
  montant Decimal @db.Decimal(15, 2)
  debut DateTime @db.Date
  fin DateTime? @db.Date
  actif Boolean @default(true)
  @@index([typeMotoId, geographieId, debut])
}
model Assujetti {
  id String @id @default(cuid()) @db.VarChar(30)
  reference String @unique @db.VarChar(60)
  nom String @db.VarChar(100)
  postnom String @db.VarChar(100)
  prenom String? @db.VarChar(100)
  sexe String @db.VarChar(20)
  naissance DateTime? @db.Date
  telephone String @db.VarChar(32)
  adresse String @db.VarChar(255)
  typePiece String? @db.VarChar(60)
  numeroPiece String? @db.VarChar(100)
  photoUrl String @db.VarChar(255)
  siteId String @db.VarChar(30)
  site Site @relation(fields: [siteId], references: [id])
  createurId String @db.VarChar(30)
  exercice Int
  statut String @default("ACTIF") @db.VarChar(30)
  deletedAt DateTime? @db.DateTime(3)
  moto Moto?
  attributions Attribution[]
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@index([siteId, createdAt])
  @@index([createurId, createdAt])
  @@index([telephone])
  @@index([nom, postnom])
}
model Moto {
  id String @id @default(cuid()) @db.VarChar(30)
  assujettiId String @unique @db.VarChar(30)
  assujetti Assujetti @relation(fields: [assujettiId], references: [id])
  typeMotoId String @db.VarChar(30)
  typeMoto TypeMoto @relation(fields: [typeMotoId], references: [id])
  plaque String @db.VarChar(80)
  chassis String? @db.VarChar(100)
  moteur String? @db.VarChar(100)
  marque String? @db.VarChar(100)
  couleur String? @db.VarChar(80)
  vole Boolean @default(false)
  declarations DeclarationVol[]
  @@index([plaque])
  @@index([chassis])
  @@index([moteur])
}
model DeclarationVol {
  id String @id @default(cuid()) @db.VarChar(30)
  motoId String @db.VarChar(30)
  moto Moto @relation(fields: [motoId], references: [id])
  reference String @unique @db.VarChar(60)
  auteurId String @db.VarChar(30)
  commentaire String? @db.Text
  statut String @default("DECLARE") @db.VarChar(30)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([motoId, statut])
}
model LotAutocollants {
  id String @id @default(cuid()) @db.VarChar(30)
  serie String @unique @db.VarChar(60)
  prefixe String @db.VarChar(30)
  debut Int
  fin Int
  longueur Int
  geographieId String @db.VarChar(30)
  createurId String @db.VarChar(30)
  autocollants Autocollant[]
  createdAt DateTime @default(now()) @db.DateTime(3)
}
model Autocollant {
  id String @id @default(cuid()) @db.VarChar(30)
  numero String @unique @db.VarChar(80)
  jeton String @unique @db.VarChar(64)
  lotId String? @db.VarChar(30)
  lot LotAutocollants? @relation(fields: [lotId], references: [id])
  geographieId String @db.VarChar(30)
  siteId String @db.VarChar(30)
  site Site @relation(fields: [siteId], references: [id])
   typeAutocollant String @map("typeStock") @db.VarChar(40)
  statut String @default("DISPONIBLE") @db.VarChar(30)
  urlPublique String? @db.VarChar(500)
  attribution Attribution?
  createdAt DateTime @default(now()) @db.DateTime(3)
   @@index([siteId, typeAutocollant, statut], map: "Autocollant_siteId_typeStock_statut_idx")
  @@index([geographieId, statut])
}
model Attribution {
  id String @id @default(cuid()) @db.VarChar(30)
  reference String @unique @db.VarChar(60)
  assujettiId String @db.VarChar(30)
  assujetti Assujetti @relation(fields: [assujettiId], references: [id])
  autocollantId String @unique @db.VarChar(30)
  autocollant Autocollant @relation(fields: [autocollantId], references: [id])
  numeroTimbre String @unique @db.VarChar(80)
  timbre Timbre @relation(fields: [numeroTimbre], references: [numero])
  agentId String @db.VarChar(30)
  exercice Int
  montant Decimal @db.Decimal(15, 2)
  transaction TransactionFinanciere?
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@unique([assujettiId, exercice])
  @@index([agentId, createdAt])
}
model Timbre {
  numero String @id @db.VarChar(80)
  siteId String @db.VarChar(30)
  site Site @relation(fields: [siteId], references: [id])
  statut String @default("ATTRIBUE") @db.VarChar(30)
  attribution Attribution?
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([siteId, createdAt])
}
model TransactionFinanciere {
  id String @id @default(cuid()) @db.VarChar(30)
  reference String @unique @db.VarChar(60)
  siteId String @db.VarChar(30)
  site Site @relation(fields: [siteId], references: [id])
  attributionId String @unique @db.VarChar(30)
  attribution Attribution @relation(fields: [attributionId], references: [id])
  auteurId String @db.VarChar(30)
  montant Decimal @db.Decimal(15, 2)
  devise String @default("CDF") @db.VarChar(10)
  statut String @default("ENCAISSE") @db.VarChar(30)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([siteId, createdAt])
  @@index([auteurId, createdAt])
}
model Recouvrement {
  id String @id @default(cuid()) @db.VarChar(30)
  reference String @unique @db.VarChar(60)
  siteId String @db.VarChar(30)
  site Site @relation(fields: [siteId], references: [id])
  montant Decimal @db.Decimal(15, 2)
  partDispromalt Decimal @db.Decimal(15, 2)
  partProvince Decimal @db.Decimal(15, 2)
  debut DateTime @db.Date
  fin DateTime @db.Date
  auteurId String @db.VarChar(30)
  utilisateurConcerneId String? @db.VarChar(30)
   moniteurId String? @db.VarChar(30)
  statut String @default("EN_ATTENTE") @db.VarChar(30)
  commentaire String? @db.Text
  validations ValidationRecouvrement[]
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([siteId, statut, createdAt])
}
model ValidationRecouvrement {
  id String @id @default(cuid()) @db.VarChar(30)
  recouvrementId String @db.VarChar(30)
  recouvrement Recouvrement @relation(fields: [recouvrementId], references: [id])
  utilisateurId String @db.VarChar(30)
  nomValidateur String @db.VarChar(140)
  etape Int
  signature String @db.Char(64)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@unique([recouvrementId, etape])
}
model JournalAudit {
  id String @id @default(cuid()) @db.VarChar(30)
  utilisateurId String? @db.VarChar(30)
  nomUtilisateur String @db.VarChar(140)
  role String @db.VarChar(60)
  action String @db.VarChar(80)
  module String @db.VarChar(60)
  objetId String? @db.VarChar(80)
  siteId String? @db.VarChar(30)
  avant Json?
  apres Json?
  ip String? @db.VarChar(45)
  appareil String? @db.VarChar(255)
  sessionId String? @db.VarChar(30)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([siteId, createdAt])
  @@index([utilisateurId, createdAt])
  @@index([module, createdAt])
}
model Notification {
  id String @id @default(cuid()) @db.VarChar(30)
  utilisateurId String @db.VarChar(30)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])
  titre String @db.VarChar(200)
  message String @db.Text
  type String @db.VarChar(50)
   lien String? @db.VarChar(255)
  luAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([utilisateurId, createdAt])
}
model AbonnementPush {
  id String @id @default(cuid()) @db.VarChar(30)
  utilisateurId String @db.VarChar(30)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])
  endpoint String @unique @db.VarChar(500)
  p256dh String @db.VarChar(255)
  auth String @db.VarChar(255)
  createdAt DateTime @default(now()) @db.DateTime(3)
}
model ParametreSysteme {
  id String @id @default(cuid()) @db.VarChar(30)
  cle String @unique @db.VarChar(100)
  valeur Json
  updatedAt DateTime @updatedAt @db.DateTime(3)
}
model LivraisonPush {
  id String @id @default(cuid()) @db.VarChar(30)
  utilisateurId String @db.VarChar(30)
  titre String @db.VarChar(200)
  message String @db.Text
  tentatives Int @default(0)
  prochaineTentative DateTime @default(now()) @db.DateTime(3)
  envoyeeAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([envoyeeAt, prochaineTentative])
}